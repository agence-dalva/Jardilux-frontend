# Backend Medusa (Railway)
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# Resend — clé API depuis resend.com/api-keys
RESEND_API_KEY=

# Interrupteur de suspension du site (voir src/proxy.ts)
# true  -> toutes les pages renvoient un 503 « Site temporairement indisponible »
# false -> site en ligne normalement
# Changer la valeur sur Vercel puis redéployer pour que la bascule prenne effet.
SITE_SUSPENDED=false

# Laissez-passer pendant une suspension : ouvrir https://le-site.fr/?acces=<token>
# pose un cookie qui laisse passer. Générer avec : openssl rand -hex 16
SITE_SUSPENDED_BYPASS_TOKEN=
